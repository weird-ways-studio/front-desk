// Cloudflare Workers config. Workers Builds deploys main only (Ben-reviewed).
// Reachable only on its workers.dev address, which Cloudflare Access guards
// (instruction.app-exposure-doors, door 2). No preview URLs.
{
  "name": "front-desk",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  // OWNER_EMAIL is set by Ben in the dashboard, not here (public repo); keep it across deploys.
  "keep_vars": true,
  // One Durable Object holds every grant, passkey and log entry (src/index.ts).
  // Before bundling, wrangler runs this; in Workers Builds on main it deploys the vault first
  // (scripts/deploy-vault.sh explains when it acts). One Builds connection ships both Workers.
  "build": { "command": "sh scripts/deploy-vault.sh" },
  // The vault Worker (vault/wrangler.jsonc) holds the sealed master key; the front desk reaches it only here.
  "services": [{ "binding": "VAULT", "service": "front-desk-vault" }],
  "durable_objects": { "bindings": [{ "name": "DESK", "class_name": "FrontDesk" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FrontDesk"] }]
}
